<%- include('partials/header') %>
<h1>Пользователи</h1>
<div class="table-wrap">
<table>
  <thead><tr><th>ID</th><th>Имя</th><th>Email</th><th>Роль</th><th>Создан</th><th></th></tr></thead>
  <tbody>
  <% users.forEach((u) => { %>
    <tr>
      <td data-label="ID"><%= u.id %></td>
      <td data-label="Имя"><%= u.first_name %> <%= u.last_name %></td>
      <td data-label="Email"><%= u.email %></td>
      <td data-label="Роль"><%= u.role %></td>
      <td data-label="Создан"><%= u.created_at.toLocaleDateString('ru-RU') %></td>
      <td class="actions">
        <% if (currentUser.role === 'admin' || currentUser.id === u.id) { %>
          <a href="/users/<%= u.id %>/edit">Изменить</a>
          <form action="/users/<%= u.id %>?_method=DELETE" method="post" class="inline"><button class="link danger">Удалить</button></form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('partials/footer') %>
